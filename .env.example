# Database (PostgreSQL required for Vercel production)
# Local dev: Use Neon free tier (https://neon.tech) or Supabase
# Production: Use Neon, Supabase, Railway, or Vercel Postgres
DATABASE_URL="postgresql://user:password@host:5432/brigap"

# JWT (generate: openssl rand -base64 32)
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"

# Google Sign-In
GOOGLE_CLIENT_ID="your-google-client-id"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id"

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# App URL (production: https://your-domain.vercel.app)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Seed: npm run db:seed creates test user test@brigap.com / Test123!
